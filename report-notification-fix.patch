diff --git a/tests/Feature/AdvancedFeaturesTest.php b/tests/Feature/AdvancedFeaturesTest.php
index 220786b..760c8e5 100644
--- a/tests/Feature/AdvancedFeaturesTest.php
+++ b/tests/Feature/AdvancedFeaturesTest.php
@@ -110,3 +110,84 @@
         ->assertOk()
         ->assertSee('Laporan Statistik');
 });
+
+it('forbids non-admin users from the report page and export', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->get(route('admin.reports.index'))->assertForbidden();
+    $this->actingAs($user)->get(route('admin.reports.export'))->assertForbidden();
+});
+
+it('rejects a report range where the start date is after the end date', function () {
+    $admin = User::factory()->admin()->create();
+
+    $this->actingAs($admin)
+        ->from(route('admin.reports.index'))
+        ->get(route('admin.reports.index', ['from' => '2026-11-20', 'to' => '2026-11-01']))
+        ->assertSessionHasErrors('to');
+});
+
+it('exports reservations as csv and neutralises spreadsheet formulas', function () {
+    $admin = User::factory()->admin()->create();
+    Reservation::factory()->create([
+        'borrower_name' => '=HYPERLINK("http://evil.test")',
+        'reservation_date' => '2026-11-19',
+    ]);
+
+    $response = $this->actingAs($admin)
+        ->get(route('admin.reports.export', ['from' => '2026-11-01', 'to' => '2026-11-30']))
+        ->assertOk()
+        ->assertDownload('laporan-reservasi-2026-11-01-2026-11-30.csv');
+
+    $content = $response->streamedContent();
+
+    expect($content)->toContain("'=HYPERLINK")
+        ->and($content)->not->toContain(',=HYPERLINK');
+});
+
+it('lists only the notifications of the logged-in user', function () {
+    $user = User::factory()->create();
+    $other = User::factory()->create();
+    $user->notify(new ReservationActivityNotification('Judul milikku', 'Pesan', '/reservation'));
+    $other->notify(new ReservationActivityNotification('Judul orang lain', 'Pesan', '/reservation'));
+
+    $this->actingAs($user)->get(route('notifications.index'))
+        ->assertOk()
+        ->assertSee('Judul milikku')
+        ->assertDontSee('Judul orang lain');
+});
+
+it('marks a notification as read and can open its target page', function () {
+    $user = User::factory()->create();
+    $user->notify(new ReservationActivityNotification('Judul', 'Pesan', '/reservation'));
+    $notification = $user->notifications()->first();
+
+    $this->actingAs($user)
+        ->patch(route('notifications.read', $notification->id), ['open' => 1])
+        ->assertRedirect('/reservation');
+
+    expect($notification->fresh()->read_at)->not->toBeNull();
+});
+
+it('does not let a user mark another user\'s notification as read', function () {
+    $owner = User::factory()->create();
+    $intruder = User::factory()->create();
+    $owner->notify(new ReservationActivityNotification('Judul', 'Pesan', '/reservation'));
+    $notification = $owner->notifications()->first();
+
+    $this->actingAs($intruder)
+        ->patch(route('notifications.read', $notification->id))
+        ->assertNotFound();
+
+    expect($notification->fresh()->read_at)->toBeNull();
+});
+
+it('marks all notifications as read', function () {
+    $user = User::factory()->create();
+    $user->notify(new ReservationActivityNotification('A', 'Pesan', '/reservation'));
+    $user->notify(new ReservationActivityNotification('B', 'Pesan', '/reservation'));
+
+    $this->actingAs($user)->post(route('notifications.read-all'))->assertSessionHas('status');
+
+    expect($user->unreadNotifications()->count())->toBe(0);
+});
